# ── Server Settings ───────────────────────────────────────────────
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
DEBUG=false
AI_DEVICE=cpu

# ── Model Architecture & Checkpoint Configuration ─────────────────
# Supported: auto | efficientnet | mobilenet
MODEL_ARCH=auto
# Optional path override (leave blank to use models/ default)
MODEL_PATH=

# ── Confidence & Uncertainty Thresholds ───────────────────────────
AI_HIGH_CONFIDENCE=0.80
AI_MEDIUM_CONFIDENCE=0.50
AI_ENTROPY_OOD_THRESHOLD=2.3
AI_MARGIN_THRESHOLD=0.10

# ── Temperature Scaling Calibration ──────────────────────────────
# Leave blank to auto-load models/temperature_T.json for calibrated models (T=0.71392)
# Set to 1.0 to explicitly disable temperature scaling
AI_TEMPERATURE=

