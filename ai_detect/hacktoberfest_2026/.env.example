# CropSentinel — hacktoberfest_2026 PS-26131
# Copy this file to .env and fill in your values. Never commit .env.

# ── App Mode ──────────────────────────────────────────────────────
APP_MODE=development        # development | production

# ── MongoDB Atlas ─────────────────────────────────────────────────
MONGODB_URI=your_mongodb_atlas_connection_string

# ── Cloudinary ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Express Server ─────────────────────────────────────────────────
PORT=4000

# ── AI Inference Microservice (Python FastAPI) ────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── Weather API (OpenWeatherMap) ──────────────────────────────────
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_CACHE_TTL_MINUTES=10

# ── AI Confidence Thresholds ──────────────────────────────────────
AI_HIGH_CONFIDENCE=0.85
AI_MEDIUM_CONFIDENCE=0.60

# ── JWT Authentication ────────────────────────────────────────────
JWT_SECRET=your_jwt_signing_secret_min_32_characters

# ── Multi-Model AI Orchestrator (Optional) ────────────────────────
OPENAI_API_KEY=your_openai_api_key_optional
OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SECONDARY=gpt-3.5-turbo

GEMINI_API_KEY=your_gemini_api_key_optional
GEMINI_MODEL_PRIMARY=gemini-1.5-pro
GEMINI_MODEL_FAST=gemini-1.5-flash

# ── Push Notifications (Optional) ─────────────────────────────────
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key
FIREBASE_SERVER_KEY=your_firebase_cloud_messaging_server_key

# ── ElevenLabs Text-to-Speech (Optional) ──────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Backboard.io Persistent AI Memory (Optional) ─────────────────
BACKBOARD_API_KEY=your_backboard_api_key_here

